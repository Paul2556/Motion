rules_version = '2';

// Every session tracks memberIds = [ownerId, ...collaboratorIds] as one
// unified list, rather than checking ownerId and collaboratorIds separately
// with an OR - Firestore's rule engine can't prove an OR across two
// different fields holds for a `list` query filtered on just one of them
// (list/collection queries need the rule to be provably true from the
// query's own filters alone, not evaluated per actual returned document), so
// a two-field OR silently breaks the exact "list sessions I own OR
// collaborate on" query this app needs - confirmed by testing, not a
// theoretical concern. A single memberIds array-contains check has no such
// problem, since the query and the rule are the same condition.
//
// Nested attendance docs check membership via one get() on the parent
// session (well under Firestore's 10-get()-per-request budget at this
// nesting depth) rather than denormalizing membership onto every doc, since
// that list can change over time and a fan-out write on every add/remove
// would be worse than one extra read per operation.
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(data) {
      return request.auth != null && request.auth.uid in data.memberIds;
    }

    function isSessionMember(sessionId) {
      return isMember(get(/databases/$(database)/documents/sessions/$(sessionId)).data);
    }

    match /sessions/{sessionId} {
      // Written inline (not via isMember()) and without a `memberIds is list`
      // type-check, specifically so this stays a single condition that
      // exactly mirrors the array-contains query listMySessions runs -
      // Firestore's list-query validator must prove the rule from the
      // query's own filter alone, and empirically, both a redundant type
      // check and routing the check through a helper function broke that
      // proof and caused every list to be denied even though every actual
      // matching document did satisfy the rule.
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      // Only the owner can rename/reconfigure the session or delete it, and
      // an update can never drop the owner's own uid from memberIds - that
      // would lock them out of their own session.
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerId
        && request.auth.uid in request.resource.data.memberIds;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      // memberIds must be exactly [creator] at creation time - collaborators
      // are only ever added afterward via the update rule above, which is
      // owner-gated. Without this, a crafted direct write could set
      // memberIds to include an arbitrary victim uid at creation, planting
      // an attacker-controlled session in that victim's session list (see
      // SEC-011 in .claude/issues.md).
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.memberIds == [request.auth.uid];

      match /attendance/{delegateId} {
        allow read, write: if isSessionMember(sessionId);
      }
    }

    // Source-access requests, their approval tokens, and the request-rate
    // counter are all written and read exclusively by api/source/*.js -
    // those functions authenticate via the Firebase Admin SDK, which bypasses
    // these rules entirely, so `if false` here isn't a bug to later relax -
    // it's the point. sourceTokens in particular double as bearer credentials
    // (the doc ID *is* the download secret), so this must never be readable
    // by any client-facing rule path, authenticated or not.
    match /sourceRequests/{requestId} {
      allow read, write: if false;
    }

    match /sourceTokens/{token} {
      allow read, write: if false;
    }

    match /rateLimits/{ip} {
      allow read, write: if false;
    }

    // Account-synced motion presets/shortcuts (src/services/prefsSync.js) -
    // one doc per user, only ever read/written by that user themselves.
    match /userPrefs/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Per-contributor page access (src/services/permissions.js), written only
    // by api/admin/permissions/*.js via the Admin SDK - self-read so a
    // contributor's own client can check their own flags, same shape as
    // userPrefs above, but writes never go through client rules since only
    // the owner (via the admin API) may grant/revoke access.
    match /contributorPermissions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Per-destination-address welcome-email cooldown (api/waitlist/welcome.js) -
    // Admin-SDK-only, same reasoning as rateLimits above.
    match /waitlistSends/{emailHash} {
      allow read, write: if false;
    }
  }
}
