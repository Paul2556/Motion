VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base64-encoded Firebase service-account JSON (Firebase Console -> Project
# Settings -> Service Accounts -> Generate new private key, then base64 -i
# key.json). Used server-side only (api/admin/*), never exposed to the client.
FIREBASE_SERVICE_ACCOUNT_B64=
# Discord bot token (Developer Portal -> Bot) - posts feedback notifications
# (api/feedback/_lib/postFeedbackNotification.js).
DISCORD_BOT_TOKEN=
# Channel ID the bot posts feedback notifications into (enable Developer
# Mode in Discord, right-click the channel -> Copy Channel ID).
DISCORD_CHANNEL_ID=
# Resend API key - sends the waitlist welcome email from hello@motionmun.com.
# Requires motionmun.com to be verified as a sending domain in Resend first.
RESEND_API_KEY=
# Google Apps Script /exec webhook URL that writes waitlist signups to the
# Sheet (api/waitlist/welcome.js). Server-side only - never expose this in
# client code, or anyone can POST fake rows to the sheet.
WAITLIST_SHEET_WEBHOOK_URL=
