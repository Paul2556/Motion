VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Source-access system (api/source/*) ---
# Base64-encoded Firebase service-account JSON (Firebase Console -> Project
# Settings -> Service Accounts -> Generate new private key, then base64 -i
# key.json). Used server-side only, never exposed to the client.
FIREBASE_SERVICE_ACCOUNT_B64=
# Shared secret checked against the x-admin-secret header on approve/deny/
# revoke. Generate with: openssl rand -hex 32
ADMIN_SECRET=
# Git tag scripts/build-source-archive.js packages as the base source
# archive at build time (falls back to HEAD with a warning if unset).
SOURCE_RELEASE_TAG=
# Fine-grained GitHub PAT, read-only "Contents" access to this repo only.
# Vercel's build clone can't git-fetch a tag from origin, so a tagged build
# downloads the tag's zipball from the GitHub API instead - this token
# authorizes that call. Not needed for local dev (falls back to `git
# archive`, which works fine against your own clone).
GITHUB_TOKEN=
# Production-only: the public origin baked into approve()'s returned
# download URL. Preview deployments fall back to Vercel's own VERCEL_URL
# instead, so a preview-issued link points at the preview that issued it.
PUBLIC_SITE_ORIGIN=
# Discord Application's public key (Developer Portal -> General Information)
# - verifies that incoming interaction requests actually came from Discord.
DISCORD_PUBLIC_KEY=
# Discord bot token (Developer Portal -> Bot) - used to post the new-request
# notification message with Approve/Deny buttons.
DISCORD_BOT_TOKEN=
# Channel ID the bot posts source-access-request notifications into (enable
# Developer Mode in Discord, right-click the channel -> Copy Channel ID).
DISCORD_CHANNEL_ID=
# Resend API key - sends approval/denial emails from hello@motionmun.com.
# Requires motionmun.com to be verified as a sending domain in Resend first.
RESEND_API_KEY=
